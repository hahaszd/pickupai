# Secrets — NEVER commit these
.env
deploy-config.json
secrets/

# Runtime data
data/

# Throwaway scratch / smoke-test artifacts
.tmp/

# Confidential business / regulatory documents — NEVER commit to a public repo
# (LOAs, ABN extracts, sender ID registrations, compliance bundles, etc.)
/*.pdf
/*.docx
/*.xlsx

# Test fixtures with real numbers (avoid leaking PII)
test-bulk-sms.csv
test-*.csv

# Scraped lead CSV files (contain business contact data)
leads-*.csv

# Build output
dist/

# Dependencies
node_modules/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code — .claude/settings.json IS committed (shared project config);
# settings.local.json is per-developer and must not be.
.claude/settings.local.json

# Saved eval runs. Transcripts of simulated calls, plus per-scenario results.
# Not committed by default: they are large, they are outputs rather than
# sources, and a run is only meaningful next to the commit it measured.
#
# To keep one as a baseline, commit it deliberately with the commit it belongs
# to — that is the pairing the comparison depends on.
.eval-runs/
