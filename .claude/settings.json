{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(railway:*)",
      "Bash(npm run test:e2e)",
      "Bash(node scripts/send-sms-batch.mjs:*)",
      "Bash(node scripts/collect-au-tradies.mjs:*)",
      "Bash(node --env-file=.env scripts/:*)",
      "Bash(npm run prospects:cleanup:apply)",
      "Bash(npm run prospects:recover-mobiles:apply)",
      "Bash(npm run prospects:enrich:apply)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(./deploy-config.json)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE 'run-eval|eval:p0' && printf '\\n⚠  PAID EVAL — before this runs:\\n   1. Has an independent agent REVIEWED the prompt change?  (iron rule: prompt-changes-review-then-widen)\\n   2. Is this the SMALLEST slice that could show it?  (--id X --repeat 3 ~ $0.30  vs  full gate ~ $3.30)\\n   3. Is only ONE thing changed since the last measurement?\\n   4. Kill it the moment a transcript shows the problem - do not let 102 conversations finish.\\n\\n' >&2; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
